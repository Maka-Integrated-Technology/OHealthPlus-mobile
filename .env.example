EXPO_PUBLIC_API_URL=https://api.example.com/api

# Google Sign-In — Web OAuth client ID from Google Cloud Console. Must match
# GOOGLE_CLIENT_ID on the backend and VITE_GOOGLE_CLIENT_ID on the dashboard:
# GoogleSignin.configure() uses this to request an ID token audienced to it,
# which is what the backend verifies against.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Sign-In — iOS OAuth client ID (separate from the web one above).
# Only needed for iOS native sign-in.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Reversed form of the iOS client ID above, e.g.
# "com.googleusercontent.apps.XXXX-XXXX". Read by app.config.ts at build
# time (not EXPO_PUBLIC_ — it's baked into native config, not the JS bundle).
GOOGLE_IOS_URL_SCHEME=

{
  "name": "ohealth-patient-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "cross-env APP_VARIANT=development npx expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android --profile preview",
    "build:ios": "eas build --platform ios --profile preview",
    "build:prod:ios": "eas build --profile production --platform ios",
    "build:prod:android": "eas build --profile production --platform android",
    "build:prod:all": "eas build --profile production --platform all",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "typecheck": "tsc --noEmit",
    "audit:dependencies": "node scripts/security/dependency-audit-policy.mjs",
    "test:audit-policy": "node --test scripts/security/dependency-audit-policy.test.mjs",
    "test:dependency-compat": "node --test scripts/compat/image-size.test.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.20.0",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-navigation-bar": "~5.0.10",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "formik": "^2.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "cross-env": "^10.1.0",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.15",
    "node-forge": "1.4.0",
    "minimatch@3": "3.1.4",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.4",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "browserslist": "4.29.3",
    "fast-uri": "3.1.8",
    "js-yaml@3": "3.15.2",
    "js-yaml@4": "4.3.2",
    "nanoid@3": "3.3.18",
    "yaml": "2.8.3",
    "postcss": "8.5.23",
    "svgo@3": "3.3.5",
    "tar@7": "7.5.21",
    "undici@6": "6.28.1",
    "uuid": "11.1.1",
    "query-string": "9.5.1",
    "image-size": "2.0.4"
  },
  "private": true
}
